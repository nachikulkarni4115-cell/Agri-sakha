# Copy this file to ".env" (never commit the real one).

# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Development only. Leave unset (or 0) in production.
FLASK_DEBUG=0

# Serve over HTTPS? Then also set this so the language cookie is HTTPS-only.
SESSION_COOKIE_SECURE=0

# Largest accepted upload in MB (the browser already compresses photos).
MAX_UPLOAD_MB=8

# Below this confidence the app asks for a better photo instead of guessing.
CONFIDENCE_THRESHOLD=0.60

# Heatmap of "what the AI looked at". Set to 0 to skip it and respond faster on small servers.
AGRISAKHA_EXPLAIN=1

# Pixel scaling override: unit (0..1) | symmetric (-1..1) | raw (0..255).
# Normally read from models/preprocessing_spec.json. Only set this if the startup log
# shows the wrong mode for how you trained the model.
# AGRISAKHA_PREPROCESS=unit

# Run on a server: HOST=0.0.0.0 (or use gunicorn: gunicorn -w 2 -b 0.0.0.0:8000 app:app)
HOST=127.0.0.1
PORT=5000
